<?xml version="1.0" encoding="utf-8"?>
<!--
  Paleidimo animacija (Android 12+): kompaso rožė su N; ašis „iškyla“ nuo horizonto iki 55° (Lietuvos platuma)
  ir Šiaurinė žvaigždė sužimba. Trukmė ~1 s, fonas juodas.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <group android:scaleX="0.75" android:scaleY="0.75" android:pivotX="54" android:pivotY="54">
                <path android:fillColor="#FF0E2047" android:strokeColor="#FF7FB4FF" android:strokeWidth="1.3"
                    android:pathData="M14,76 a40,13 0 1,0 80,0 a40,13 0 1,0 -80,0"/>
                <path android:fillColor="#CCC7D3EA" android:pathData="M14,76 L54,74 L94,76 L54,78Z"/>
                <path android:fillColor="#FFFF5A4E" android:pathData="M54,63 L57,76 L54,89 L51,76Z"/>
                <path android:strokeColor="#FFFF8A80" android:strokeWidth="1.5" android:strokeLineCap="round" android:strokeLineJoin="round"
                    android:pathData="M50.5,61 L50.5,54 L57.5,61 L57.5,54"/>
                <group android:name="axisG" android:pivotX="54" android:pivotY="76" android:rotation="55">
                    <path android:name="axis" android:strokeColor="#FFFFF3C4" android:strokeWidth="2" android:strokeLineCap="round"
                        android:trimPathEnd="0" android:pathData="M54,76 L84,33"/>
                    <group android:name="starG" android:pivotX="84" android:pivotY="33" android:scaleX="0" android:scaleY="0">
                        <path android:name="glow" android:fillColor="#FFFFE9A8" android:fillAlpha="0.25" android:pathData="M76.00,33.00 a8.00,8.00 0 1,0 16.00,0 a8.00,8.00 0 1,0 -16.00,0"/>
                        <path android:fillColor="#73FFE9A8" android:pathData="M79.40,33.00 a4.60,4.60 0 1,0 9.20,0 a4.60,4.60 0 1,0 -9.20,0"/>
                        <path android:fillColor="#FFFFFBE9" android:pathData="M84,27.5 L85.1,31.9 L89.5,33 L85.1,34.1 L84,38.5 L82.9,34.1 L78.5,33 L82.9,31.9Z"/>
                    </group>
                </group>
                <path android:fillColor="#FFFFFFFF" android:pathData="M51.40,76.00 a2.60,2.60 0 1,0 5.20,0 a2.60,2.60 0 1,0 -5.20,0"/>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="axis">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:duration="350" android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
    <target android:name="axisG">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="rotation" android:valueFrom="55" android:valueTo="0" android:startOffset="150"
                android:duration="600" android:interpolator="@android:interpolator/decelerate_cubic"/>
        </aapt:attr>
    </target>
    <target android:name="starG">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set android:startOffset="600">
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1.5" android:duration="180"
                        android:interpolator="@android:interpolator/decelerate_quad"/>
                    <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1.5" android:duration="180"
                        android:interpolator="@android:interpolator/decelerate_quad"/>
                </set>
                <set>
                    <objectAnimator android:propertyName="scaleX" android:valueFrom="1.5" android:valueTo="1" android:duration="220"
                        android:interpolator="@android:interpolator/accelerate_decelerate"/>
                    <objectAnimator android:propertyName="scaleY" android:valueFrom="1.5" android:valueTo="1" android:duration="220"
                        android:interpolator="@android:interpolator/accelerate_decelerate"/>
                </set>
            </set>
        </aapt:attr>
    </target>
    <target android:name="glow">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.25" android:valueTo="0.9" android:startOffset="700"
                    android:duration="120"/>
                <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.9" android:valueTo="0.3" android:duration="160"/>
                <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.3" android:valueTo="0.6" android:duration="120"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
